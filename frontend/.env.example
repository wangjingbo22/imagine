# Copy this file to frontend/.env. Never commit real credentials.
# Leave blank for local Vite proxy; set an HTTPS API origin in production.
VITE_API_BASE_URL=
# Local backend used by the Vite proxy.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Use an AMap platform key whose service type is "Web (JS API)".
# This is separate from the backend AMAP_WEB_SERVICE_KEY.
VITE_AMAP_JS_API_KEY=
VITE_AMAP_SECURITY_JS_CODE=

VITE_USE_MOCK_API=false
VITE_USE_PLAN_VERSION_API=true
VITE_USE_WORKFLOW_API=true
