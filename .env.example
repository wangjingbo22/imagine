# Copy this file to .env. Never commit a real key.
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_REQUEST_TIMEOUT_SECONDS=8
AMAP_CACHE_DB_PATH=data/amap_cache.sqlite3
AMAP_PLACE_CACHE_TTL_SECONDS=86400
AMAP_ROUTE_CACHE_TTL_SECONDS=1800
# 阿里云百炼华北2（北京）OpenAI 兼容接口。真实 Key 只填本地 .env。
BAILIAN_API_KEY=
# 用于加密保存登录用户绑定的 API Key；生产环境必须设置为 Fernet 密钥，严禁提交真实值。
ACCOUNT_API_KEY_ENCRYPTION_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_ORGANIZER_MODEL=qwen-turbo
# S2-T004 trip understanding: hard per-attempt timeout, accepted range 8..45 seconds.
BAILIAN_REQUEST_TIMEOUT_SECONDS=45
# S2-T008 candidate proposal: fixed short timeout, accepted range 8..12 seconds.
BAILIAN_CANDIDATE_TIMEOUT_SECONDS=10
# S2-T019 requires a hard 10-second timeout before the fixed form fallback.
BAILIAN_EXECUTION_EVENT_TIMEOUT_SECONDS=10
# S2-T022: difference explanation is display-only and never blocks plan results.
BAILIAN_REPLAN_EXPLANATION_TIMEOUT_SECONDS=10
PLAN_VERSION_DB_PATH=data/plan_versions.sqlite3
ACCOUNT_SESSION_DB_PATH=data/account.sqlite3
ACCOUNT_SESSION_TTL_DAYS=14
# Production deployments must set both APP_ENVIRONMENT=production and AUTH_COOKIE_SECURE=true.
APP_ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
