      "type": "object"
    },
    "ParticipantUnderstanding": {
      "additionalProperties": false,
      "properties": {
        "avoidPlaces": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 0,
          "title": "Avoidplaces",
          "type": "array"
        },
        "budgetCapCents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Budgetcapcents"
        },
        "careDraft": {
          "anyOf": [
            {
              "$ref": "#/$defs/CareDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "interests": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 0,
          "title": "Interests",
          "type": "array"
        },
        "memberKey": {
          "pattern": "^member-[1-3]$",
          "title": "Memberkey",
          "type": "string"
        },
        "mustVisit": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 0,
          "title": "Mustvisit",
          "type": "array"
        },
        "nickname": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nickname"
        }
      },
      "required": [
        "memberKey",
        "nickname",
        "budgetCapCents",
        "interests",
        "mustVisit",
        "avoidPlaces",
        "careDraft"
      ],
      "title": "ParticipantUnderstanding",
      "type": "object"
    },
    "TripUnderstandingTrip": {
      "additionalProperties": false,
      "properties": {
        "budgetCents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Budgetcents"
        },
        "cityName": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cityname"
        },
        "endLocationText": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Endlocationtext"
        },
        "endTime": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Endtime"
        },
        "startLocationText": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Startlocationtext"
        },
        "startTime": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Starttime"
        },
        "travelDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Traveldate"
        }
      },
      "required": [
        "cityName",
        "travelDate",
        "startTime",
        "endTime",
        "startLocationText",
        "endLocationText",
        "budgetCents"
      ],
      "title": "TripUnderstandingTrip",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/Ambiguity"
      },
      "maxItems": 50,
      "minItems": 0,
      "title": "Ambiguities",
      "type": "array"
    },
    "confirmationQuestions": {
      "items": {
        "$ref": "#/$defs/ConfirmationQuestion"
      },
      "maxItems": 50,
      "minItems": 0,
      "title": "Confirmationquestions",
      "type": "array"
    },
    "fieldEvidence": {
      "items": {
        "$ref": "#/$defs/FieldEvidence"
      },
      "maxItems": 100,
      "minItems": 0,
      "title": "Fieldevidence",
      "type": "array"
    },
    "missingFields": {
      "items": {
        "$ref": "#/$defs/MissingField"
      },
      "maxItems": 50,
      "minItems": 0,
      "title": "Missingfields",
      "type": "array"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/ParticipantUnderstanding"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Participants",
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "trip": {
      "$ref": "#/$defs/TripUnderstandingTrip"
    }
