  "required": [
    "schemaVersion",
    "trip",
    "participants",
    "fieldEvidence",
    "missingFields",
    "ambiguities",
    "confirmationQuestions"
  ],
  "title": "TripUnderstandingProposal",
  "type": "object"
}
