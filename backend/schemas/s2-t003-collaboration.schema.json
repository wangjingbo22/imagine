{
  "$defs": {
    "CollaborationAggregate": {
      "$defs": {
        "ActorScope": {
          "enum": [
            "ORGANIZER",
            "PARTICIPANT"
          ],
          "title": "ActorScope",
          "type": "string"
        },
        "CollaborationIssue": {
          "additionalProperties": false,
          "properties": {
            "candidates": {
              "items": {
                "type": "string"
              },
              "maxItems": 5,
              "title": "Candidates",
              "type": "array"
            },
            "code": {
              "$ref": "#/$defs/IssueCode"
            },
            "fieldPath": {
              "pattern": "(?:trip\\.(?:cityName|travelDate|startTime|endTime|startLocationText|endLocationText|budgetCents)|participants|participants\\[\\d+\\]\\.(?:nickname|budgetCapCents|interests\\[\\d+\\]|mustVisit\\[\\d+\\]|avoidPlaces\\[\\d+\\]|careDraft\\.(?:assistanceTypeHint|childAge|walkLimits\\.(?:maxContinuousMeters|maxDailyMeters)|maxTransfers|restIntervalMinutes|napWindow\\.(?:start|end)|avoidStairs)))",
              "title": "Fieldpath",
              "type": "string"
            },
            "itemId": {
              "pattern": "^ci_[a-f0-9]{16}$",
              "title": "Itemid",
              "type": "string"
            },
            "participantId": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Participantid"
            },
            "reason": {
              "maxLength": 240,
              "minLength": 1,
              "title": "Reason",
              "type": "string"
            },
            "relatedParticipantIds": {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "title": "Relatedparticipantids",
              "type": "array"
            },
            "relaxations": {
              "items": {
                "$ref": "#/$defs/RelaxationOption"
              },
              "title": "Relaxations",
              "type": "array"
            },
            "ruleId": {
              "pattern": "^S2T003\\.[A-Z0-9_.]+$",
              "title": "Ruleid",
              "type": "string"
            }
          },
          "required": [
            "itemId",
            "fieldPath",
            "participantId",
            "relatedParticipantIds",
            "ruleId",
            "code",
            "reason"
          ],
          "title": "CollaborationIssue",
          "type": "object"
        },
        "CollaborationProgress": {
          "additionalProperties": false,
          "properties": {
            "confirmedCount": {
              "maximum": 3,
              "minimum": 0,
              "title": "Confirmedcount",
              "type": "integer"
            },
            "expectedCount": {
              "maximum": 3,
              "minimum": 1,
              "title": "Expectedcount",
              "type": "integer"
            },
            "openIssueCount": {
              "minimum": 0,
              "title": "Openissuecount",
              "type": "integer"
            }
          },
          "required": [
            "expectedCount",
            "confirmedCount",
            "openIssueCount"
          ],
          "title": "CollaborationProgress",
          "type": "object"
        },
        "CollaborationStatus": {
          "enum": [
            "MIGRATION_REQUIRED",
            "DRAFT_CONVERSATION",
            "INVITING",
            "COLLECTING_MEMBERS",
            "CONFLICT_REVIEW",
            "READY_TO_PLAN"
          ],
          "title": "CollaborationStatus",
          "type": "string"
        },
        "IssueCode": {
          "enum": [
            "MISSING",
            "AMBIGUOUS",
            "INVALID",
            "CONFLICT"
          ],
          "title": "IssueCode",
          "type": "string"
        },
        "JsonValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "ParticipantAccessStatus": {
          "enum": [
            "ORGANIZER_ACTIVE",
            "NOT_INVITED",
            "INVITED",
            "SESSION_ACTIVE",
            "REVOKED",
            "EXPIRED"
          ],
          "title": "ParticipantAccessStatus",
          "type": "string"
        },
        "ParticipantConfirmationStatus": {
          "enum": [
            "MIGRATION_REQUIRED",
            "DRAFT",
            "CONFIRMED",
            "NEEDS_RECONFIRMATION"
          ],
          "title": "ParticipantConfirmationStatus",
          "type": "string"
        },
        "ParticipantProgress": {
          "additionalProperties": false,
          "properties": {
            "accessStatus": {
              "$ref": "#/$defs/ParticipantAccessStatus"
            },
            "confirmationStatus": {
              "$ref": "#/$defs/ParticipantConfirmationStatus"
            },
            "confirmedRevision": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Confirmedrevision"
            },
            "memberKey": {
              "pattern": "^member-[1-3]$",
              "title": "Memberkey",
              "type": "string"
            },
            "participantId": {
              "format": "uuid",
              "title": "Participantid",
              "type": "string"
            },
            "role": {
              "enum": [
                "ORGANIZER",
                "MEMBER"
              ],
              "title": "Role",
              "type": "string"
            }
          },
          "required": [
            "participantId",
            "memberKey",
            "role",
            "accessStatus",
            "confirmationStatus"
          ],
          "title": "ParticipantProgress",
          "type": "object"
        },
        "RelaxationAction": {
          "enum": [
            "SELECT_CANDIDATE",
            "SET_SHARED_FIELD",
            "SET_MEMBER_FIELD",
            "REMOVE_MUST_VISIT",
            "REMOVE_AVOID_PLACE",
            "RAISE_MEMBER_BUDGET_CAP",
            "LOWER_SHARED_BUDGET",
            "EXTEND_SHARED_TIME",
            "CHANGE_NAP_WINDOW"
          ],
          "title": "RelaxationAction",
          "type": "string"
        },
        "RelaxationOption": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/RelaxationAction"
            },
            "actorScope": {
              "$ref": "#/$defs/ActorScope"
            },
            "fieldPath": {
              "pattern": "(?:trip\\.(?:cityName|travelDate|startTime|endTime|startLocationText|endLocationText|budgetCents)|participants|participants\\[\\d+\\]\\.(?:nickname|budgetCapCents|interests\\[\\d+\\]|mustVisit\\[\\d+\\]|avoidPlaces\\[\\d+\\]|careDraft\\.(?:assistanceTypeHint|childAge|walkLimits\\.(?:maxContinuousMeters|maxDailyMeters)|maxTransfers|restIntervalMinutes|napWindow\\.(?:start|end)|avoidStairs)))",
              "title": "Fieldpath",
              "type": "string"
            },
            "label": {
              "maxLength": 160,
              "minLength": 1,
              "title": "Label",
              "type": "string"
            },
            "participantId": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Participantid"
            },
            "proposedValue": {
              "$ref": "#/$defs/JsonValue"
            },
            "relaxationId": {
              "pattern": "^rx_[a-f0-9]{16}$",
              "title": "Relaxationid",
              "type": "string"
            }
          },
          "required": [
            "relaxationId",
            "action",
            "actorScope",
            "participantId",
            "fieldPath",
            "proposedValue",
            "label"
          ],
          "title": "RelaxationOption",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "canPlan": {
          "title": "Canplan",
          "type": "boolean"
        },
        "collaborationVersion": {
          "minimum": 1,
          "title": "Collaborationversion",
          "type": "integer"
        },
        "confirmationItems": {
          "items": {
            "$ref": "#/$defs/CollaborationIssue"
          },
          "title": "Confirmationitems",
          "type": "array"
        },
        "currentRevision": {
          "minimum": 1,
          "title": "Currentrevision",
          "type": "integer"
        },
        "draftId": {
          "format": "uuid",
          "title": "Draftid",
          "type": "string"
        },
        "organizerParticipantId": {
          "format": "uuid",
          "title": "Organizerparticipantid",
          "type": "string"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/ParticipantProgress"
          },
          "title": "Participants",
          "type": "array"
        },
        "policyVersion": {
          "const": "S2-T003.1",
          "default": "S2-T003.1",
          "title": "Policyversion",
          "type": "string"
        },
        "progress": {
          "$ref": "#/$defs/CollaborationProgress"
        },
        "readinessDigest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Readinessdigest"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CollaborationStatus"
        },
        "tripId": {
          "format": "uuid",
          "title": "Tripid",
          "type": "string"
        }
      },
      "required": [
        "tripId",
        "draftId",
        "currentRevision",
        "organizerParticipantId",
        "status",
        "collaborationVersion",
        "canPlan",
        "progress",
        "participants",
        "confirmationItems"
      ],
      "title": "CollaborationAggregate",
      "type": "object"
    },
