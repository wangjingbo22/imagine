    "MemberSessionView": {
      "$defs": {
        "ActorScope": {
          "enum": [
            "ORGANIZER",
            "PARTICIPANT"
          ],
          "title": "ActorScope",
          "type": "string"
        },
        "CareDraft": {
          "additionalProperties": false,
          "properties": {
            "assistanceTypeHint": {
              "anyOf": [
                {
                  "enum": [
                    "ORDINARY",
                    "PARENT_CHILD",
                    "LOW_STAMINA",
                    "MOBILITY_ASSISTANCE_BETA"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Assistancetypehint"
            },
            "avoidStairs": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Avoidstairs"
            },
            "childAge": {
              "anyOf": [
                {
                  "maximum": 17,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Childage"
            },
            "maxTransfers": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maxtransfers"
            },
            "napWindow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CareNapWindow"
                },
                {
                  "type": "null"
                }
              ]
            },
            "restIntervalMinutes": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Restintervalminutes"
            },
            "walkLimits": {
              "$ref": "#/$defs/CareWalkLimits"
            }
          },
          "required": [
            "assistanceTypeHint",
            "childAge",
            "walkLimits",
            "maxTransfers",
            "restIntervalMinutes",
            "napWindow",
            "avoidStairs"
          ],
          "title": "CareDraft",
          "type": "object"
        },
        "CareNapWindow": {
          "additionalProperties": false,
          "properties": {
            "end": {
              "anyOf": [
                {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            },
            "start": {
              "anyOf": [
                {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "title": "CareNapWindow",
          "type": "object"
        },
        "CareWalkLimits": {
          "additionalProperties": false,
          "properties": {
            "maxContinuousMeters": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maxcontinuousmeters"
            },
            "maxDailyMeters": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maxdailymeters"
            }
          },
          "required": [
            "maxContinuousMeters",
            "maxDailyMeters"
          ],
          "title": "CareWalkLimits",
          "type": "object"
        },
        "CollaborationIssue": {
          "additionalProperties": false,
          "properties": {
            "candidates": {
              "items": {
                "type": "string"
              },
              "maxItems": 5,
              "title": "Candidates",
              "type": "array"
            },
            "code": {
              "$ref": "#/$defs/IssueCode"
