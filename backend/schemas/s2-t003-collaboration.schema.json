        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "invitationId": {
          "format": "uuid",
          "title": "Invitationid",
          "type": "string"
        },
        "invitationUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
