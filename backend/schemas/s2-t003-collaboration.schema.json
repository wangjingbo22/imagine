        "participantId",
        "invitationUrl",
        "expiresAt",
        "linkAvailable",
        "collaborationVersion"
      ],
      "title": "InvitationCreated",
      "type": "object"
    },
    "InvitationRedeemRequest": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
