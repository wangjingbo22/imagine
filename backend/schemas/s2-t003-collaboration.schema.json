    "CollaborationProgress": {
      "additionalProperties": false,
      "properties": {
        "confirmedCount": {
          "maximum": 3,
          "minimum": 0,
          "title": "Confirmedcount",
          "type": "integer"
        },
        "expectedCount": {
          "maximum": 3,
          "minimum": 1,
          "title": "Expectedcount",
          "type": "integer"
        },
        "openIssueCount": {
          "minimum": 0,
          "title": "Openissuecount",
          "type": "integer"
        }
      },
      "required": [
        "expectedCount",
        "confirmedCount",
        "openIssueCount"
      ],
      "title": "CollaborationProgress",
      "type": "object"
    },
    "InvitationCreateRequest": {
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "minimum": 1,
          "title": "Expectedversion",
          "type": "integer"
        },
        "expiresInHours": {
          "default": 72,
          "maximum": 168,
          "minimum": 1,
          "title": "Expiresinhours",
          "type": "integer"
        },
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "expectedVersion"
      ],
      "title": "InvitationCreateRequest",
      "type": "object"
    },
    "InvitationCreated": {
      "additionalProperties": false,
      "properties": {
        "collaborationVersion": {
          "minimum": 1,
          "title": "Collaborationversion",
          "type": "integer"
